# Firebase (Project settings -> General -> Your apps -> Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
# Optional: override the defaults in config/firebaseConfig.js to use your own project
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
# NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Liveblocks (https://liveblocks.io/dashboard -> API keys)
